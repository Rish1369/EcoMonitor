{
    "id": "ecomonitor-local-env",
    "name": "EcoMonitor – Local",
    "_postman_variable_scope": "environment",
    "values": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "type": "default",
            "enabled": true,
            "description": "Base URL of the running Django/Uvicorn server."
        },
        {
            "key": "username",
            "value": "testuser",
            "type": "default",
            "enabled": true,
            "description": "Username to use for Register and Login."
        },
        {
            "key": "password",
            "value": "testpassword123",
            "type": "default",
            "enabled": true,
            "description": "Password for the test user."
        },
        {
            "key": "access_token",
            "value": "",
            "type": "secret",
            "enabled": true,
            "description": "JWT access token — auto-populated by the Login request's Tests script."
        },
        {
            "key": "refresh_token",
            "value": "",
            "type": "secret",
            "enabled": true,
            "description": "JWT refresh token — auto-populated by the Login request's Tests script."
        },
        {
            "key": "current_task_id",
            "value": "",
            "type": "default",
            "enabled": true,
            "description": "UUID of the most recently created task — auto-populated by Create Task's Tests script."
        },
        {
            "key": "poll_count",
            "value": "0",
            "type": "default",
            "enabled": true,
            "description": "Tracks how many times Poll Status has looped. Reset to 0 when COMPLETED."
        }
    ]
}
